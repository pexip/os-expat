Subject: tests: Set isFinal=1 in line/column-number-after-error tests

Origin: https://github.com/libexpat/libexpat/commit/d4105a9080271a8d4996d2454f89be9992cb268a
---
 expat/tests/runtests.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/expat/tests/runtests.c b/expat/tests/runtests.c
index c8e5e61..57ca0ee 100644
--- a/expat/tests/runtests.c
+++ b/expat/tests/runtests.c
@@ -1149,7 +1149,7 @@ START_TEST(test_line_number_after_error) {
                      "  <b>\n"
                      "  </a>"; /* missing </b> */
   XML_Size lineno;
